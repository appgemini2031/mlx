{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information authenticated via Google Sign-In",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique ID matching Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp via server timestamp"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "VcamCloudConfig": {
      "title": "VCam Cloud Config",
      "description": "Synchronized camera configuration and live streaming presets for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "isMasterEnabled": {
          "type": "boolean",
          "description": "Master camera hook toggle"
        },
        "rotation": {
          "type": "integer",
          "description": "Video rotation in degrees (0, 90, 180, 270)"
        },
        "isMirrored": {
          "type": "boolean",
          "description": "Horizontal flip flag"
        },
        "isVerticalFlipped": {
          "type": "boolean",
          "description": "Vertical flip flag"
        },
        "scaleMode": {
          "type": "string",
          "description": "Scale mode: CROP, FIT, STRETCH"
        },
        "audioEnabled": {
          "type": "boolean",
          "description": "Master audio flag"
        },
        "loopPlayback": {
          "type": "boolean",
          "description": "Loop current media"
        },
        "autoNextEnabled": {
          "type": "boolean",
          "description": "Playlist auto-advance toggle"
        },
        "autoNextMode": {
          "type": "string",
          "description": "Auto advance mode (SEQUENTIAL, RANDOM, SINGLE_LOOP)"
        },
        "forceResolution": {
          "type": "string",
          "description": "Resolution preset name"
        },
        "fps": {
          "type": "integer",
          "description": "Target frame rate"
        },
        "floatingAlpha": {
          "type": "number",
          "description": "Floating window opacity (0.25 to 1.0)"
        },
        "hookEngine": {
          "type": "string",
          "description": "Camera hook engine type"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when config was saved"
        }
      },
      "required": ["userId", "updatedAt"]
    },
    "CloudPlaylistItem": {
      "title": "Cloud Playlist Item",
      "description": "Metadata for saved videos or clips in a user playlist",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Item unique identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "name": {
          "type": "string",
          "description": "File or clip title"
        },
        "durationMs": {
          "type": "integer",
          "description": "Duration in milliseconds"
        },
        "sizeBytes": {
          "type": "integer",
          "description": "File size in bytes"
        },
        "width": {
          "type": "integer",
          "description": "Video frame width"
        },
        "height": {
          "type": "integer",
          "description": "Video frame height"
        },
        "isMuted": {
          "type": "boolean",
          "description": "Whether video audio track is muted"
        },
        "isEnabled": {
          "type": "boolean",
          "description": "Whether item is included in active playlist"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When item was added"
        }
      },
      "required": ["id", "userId", "name", "addedAt"]
    },
    "DeviceTelemetry": {
      "title": "Device Telemetry & Remote State",
      "description": "Heartbeat, device telemetry, and remote commands",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "model": { "type": "string" },
        "androidVersion": { "type": "string" },
        "appVersion": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "batteryLevel": { "type": "integer" },
        "ramUsageMb": { "type": "integer" },
        "licenseExpiry": { "type": "string" },
        "currentVideo": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "activeCommand": { "type": "object" }
      },
      "required": ["deviceId", "lastSeen"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document storing account details"
    },
    "/users/{userId}/configs/{configId}": {
      "schema": "VcamCloudConfig",
      "description": "User camera configurations and live streaming presets"
    },
    "/users/{userId}/playlist/{playlistId}": {
      "schema": "CloudPlaylistItem",
      "description": "Cloud synchronized video playlist items for the user"
    },
    "/devices/{deviceId}": {
      "schema": "DeviceTelemetry",
      "description": "Realtime telemetry and remote control state per device"
    }
  }
}
